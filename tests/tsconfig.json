{
  "extends": "../tsconfig",
  "compilerOptions": {
    "paths": {
      "kern-jobs": ["../src"],
      "kern-jobs/db/*": ["../src/db/*"],
      "kern-jobs/migrations": ["../src/migrations.ts"],
      "kern-jobs/worker": ["../src/worker.ts"]
    }
  },
  "include": ["**/*.ts"],
  // The package test type-checks its consumer fixtures against the packed package.
  "exclude": ["package/fixtures"]
}
